DATABASE_URL=postgres://user:pass@localhost:5432/amebo
# Google OAuth client (Cloud Console → APIs & Services → Credentials → OAuth client ID, type "Web application").
# Authorized redirect URI: <app origin>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Random 32+ byte secret: `npx auth secret` or `openssl rand -base64 33`
AUTH_SECRET=
# Behind a proxy / non-Vercel host in production, also set AUTH_URL=https://your.domain
# Provider keys — set only the ones in use; the bake-off decides the default model per org
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
GLM_API_KEY=
